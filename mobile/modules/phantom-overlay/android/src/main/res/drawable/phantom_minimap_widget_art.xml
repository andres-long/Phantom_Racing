  <path android:pathData="M60,2 A58,58 0 1,1 59.99,2 Z" android:fillColor="#222CE8F5" />
  <!-- The scope. -->
  <path android:pathData="M60,8 A52,52 0 1,1 59.99,8 Z" android:fillColor="#F2070B12" />
